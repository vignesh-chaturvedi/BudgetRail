# Public, non-secret defaults. Copy to .env.local for development.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# BudgetRail defaults to Circle's canonical devnet USDC mint when this is empty:
# 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Test tokens: https://faucet.circle.com/
# Override only for isolated local testing. Never commit private keys.
NEXT_PUBLIC_BUDGETRAIL_MERCHANT=
NEXT_PUBLIC_BUDGETRAIL_TOKEN_MINT=

# x402 v2 uses the CAIP-2 identifier below for Solana devnet.
BUDGETRAIL_X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
BUDGETRAIL_MAX_PAYMENT_BASE_UNITS=100000

# Public, non-secret defaults. Copy to .env.local for development.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC values are shipped to browsers. Never place an authenticated RPC
# URL or API key here.

# BudgetRail defaults to Circle's canonical devnet USDC mint when this is empty:
# 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Test tokens: https://faucet.circle.com/
# Override only for isolated local testing. Never commit private keys.
NEXT_PUBLIC_BUDGETRAIL_MERCHANT=
NEXT_PUBLIC_BUDGETRAIL_TOKEN_MINT=

# Devnet endpoint the disposable judge rail forks from. Server-only: this value
# may carry an API key, so it must never be added as a NEXT_PUBLIC_* variable.
# Leave empty to use the public endpoint. Put the real value in .env.local,
# which is gitignored and excluded from the Docker build.
BUDGETRAIL_DEVNET_RPC_URL=

# Surfpool 1.4 stops answering ledger state after roughly 1,050 produced slots,
# and it does so silently: getHealth and getVersion keep succeeding while
# getSlot, getAccountInfo, and the console hang. The budget is spent in slots,
# not seconds, so the slot tick decides how long a rail survives. At Surfpool's
# default tick a rail dies about 90 seconds after it starts; the value below
# stretches the same budget across hours. Confirmations stay immediate.
BUDGETRAIL_SLOT_TIME_MS=400
BUDGETRAIL_BLOCK_PRODUCTION_MODE=transaction

# x402 v2 uses the CAIP-2 identifier below for Solana devnet.
BUDGETRAIL_X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
BUDGETRAIL_MAX_PAYMENT_BASE_UNITS=100000

# Release profile. Keep `local` for development. A hosted grant demo must set
# `grant-demo`, use the final HTTPS origin, and run exactly one container.
BUDGETRAIL_DEPLOYMENT_MODE=local
BUDGETRAIL_RUNTIME=local
BUDGETRAIL_PUBLIC_URL=http://localhost:3000
BUDGETRAIL_REPLICA_COUNT=1
# Leave unset on a host that injects a commit SHA (Render, Railway, Vercel).
# A hand-set value wins over the platform value and goes stale on redeploy.
BUDGETRAIL_BUILD_SHA=

# This flag is a tripwire, not an enable switch. Phase 6 deliberately blocks a
# release if it is true; mainnet activation requires a separate safety review.
BUDGETRAIL_ENABLE_MAINNET_WRITES=false

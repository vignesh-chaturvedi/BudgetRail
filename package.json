{
  "name": "budgetrail",
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "next build",
    "ci": "pnpm typecheck && pnpm test && pnpm lint && pnpm build",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "phase1:spike": "tsx scripts/phase1-compatibility-spike.ts",
    "phase1:devnet": "tsx scripts/phase1-devnet-proof.ts",
    "phase1:local": "tsx scripts/phase1-devnet-proof.ts --local",
    "phase2:local": "tsx scripts/phase2-local-proof.ts",
    "phase3:local": "tsx scripts/phase3-local-proof.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "description": "Capped, expiring and revocable USDC authority for autonomous x402 payments on Solana",
  "keywords": [
    "kit",
    "nextjs",
    "react",
    "solana-kit",
    "subscriptions",
    "recurring-payments",
    "token-delegation",
    "tailwind",
    "typescript"
  ],
  "private": true,
  "dependencies": {
    "@solana-program/compute-budget": "0.16.0",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "6.9.0",
    "@solana/kit-plugin-rpc": "^0.11.1",
    "@solana/kit-plugin-signer": "^0.10.0",
    "@solana/subscriptions": "^0.3.0",
    "@solana/wallet-standard-features": "^1.3.0",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "@x402/core": "2.20.0",
    "@x402/fetch": "2.20.0",
    "@x402/svm": "2.20.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "swr": "^2.2.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@solana/surfpool": "1.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
